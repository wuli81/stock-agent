# 数据库连接（开发默认 SQLite；生产可换 postgresql://user:pass@host:5432/stock_agent）
STOCK_AGENT_DATABASE_URL=sqlite:///./data/stock_agent.db
# 逗号分隔的 API Key
STOCK_AGENT_API_KEYS=dev-key
# 是否启用定时任务（收盘后自动分析）
STOCK_AGENT_ENABLE_SCHEDULER=false
STOCK_AGENT_LOG_LEVEL=INFO

# 数据源（akshare 需联网访问行情接口）
STOCK_AGENT_DATA_PROVIDER=akshare
# 逗号分隔的跟踪股票代码
STOCK_AGENT_TRACKED_STOCKS=600000,000001
# 使用的策略名（见 app/strategy/plugins/）
STOCK_AGENT_STRATEGY_NAME=ma_cross
# 计划总预算（元）
STOCK_AGENT_PLAN_BUDGET=100000
# 行情回溯天数
STOCK_AGENT_QUOTE_LOOKBACK_DAYS=60
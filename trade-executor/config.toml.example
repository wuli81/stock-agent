# trade-executor 配置示例：复制为 config.toml 后修改
backend_base_url = "http://localhost:8000/api/v1"
api_key = "dev-key"
mode = "manual"              # auto | manual
executor_id = "win-01"
retry_max = 3
retry_backoff_seconds = 5

# 券商适配器：demo | paper | client(实验性，pywinauto 脚手架)
broker = "paper"
# paper 撮合价模式：mid | min | max | fixed
fill_mode = "mid"
fixed_price = 10.0
# 逗号分隔的拒单股票代码（风控示例）
reject_codes = ""

# OCR 成交确认（v0.3）：tesseract | paddle | fake；空 = 关闭
ocr_engine = ""
# 截图区域 "left,top,width,height"
ocr_region = ""